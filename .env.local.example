# ─── PayFast ──────────────────────────────────────────────────────────────────
# Get these from your PayFast merchant dashboard: https://www.payfast.co.za
PAYFAST_MERCHANT_ID=your_merchant_id_here
PAYFAST_MERCHANT_KEY=your_merchant_key_here
PAYFAST_PASSPHRASE=your_passphrase_here   # Set in PayFast dashboard under Security

# Set to "true" while testing, "false" for live payments
PAYFAST_SANDBOX=true

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Your deployed site URL (no trailing slash) — used for PayFast return/cancel/notify URLs
# In development this is automatically http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://yourdomain.co.za
